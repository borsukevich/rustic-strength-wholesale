    "multirow_WF3J4E": {
      "type": "multirow",
      "blocks": {
        "row_PMX4X9": {
          "type": "row",
          "settings": {
            "image": "shopify://shop_images/Mock_Refill_Shop_2X3_2.jpg",
            "caption": "Before applying our branding",
            "heading": "Understand Our Mission and Values",
            "text": "<p>It's helpful to understand what drives us. This will help you represent Rustic Strength in a way that is true to its identity.</p><p><strong>Our Mission:</strong> We aim to offer safe, non-toxic household and personal care products that protect your health, the planet, and the people who make them.</p><p><strong>Our Core Values:</strong></p><ul><li>Radical Transparency</li><li>Sustainability Over Waste</li><li>Human + Earth Friendly Ingredients</li><li>Bold Simplicity</li><li>Family-Owned Authenticity</li></ul><p><strong>Our Voice:</strong> When you write about Rustic Strength, aim for a tone that is Honest & Empowering, Educated & Well-versed, and Friendly & Approachable.</p>",
            "button_label": "",
            "button_link": ""
          }
        },
        "row_ANMQRV": {
          "type": "row",
          "settings": {
            "image": "shopify://shop_images/760_refill_RS_42d83ee5-ab1b-4c1f-a5d7-8bb21e200d8d.jpg",
            "caption": "",
            "heading": "How to Use Our Logo",
            "text": "<p>Proper logo usage is key to brand recognition. Please follow these simple rules.</p><p><strong>Sizing:</strong></p><ul><li>For print materials, the logo must have a minimum width of 1 inch.</li><li>For digital platforms (websites, social media), the logo must have a minimum width of 150 pixels.</li></ul><p><strong>Clear Space:</strong> To ensure its visibility and impact, always maintain a clear space around the logo that is at least the height of the \"X\" in the design.</p>",
            "button_label": "Downloadable Assets",
            "button_link": "shopify://pages/downloadable-assets"
          }
        },
        "row_qPYadi": {
          "type": "row",
          "settings": {
            "image": "shopify://shop_images/tall_bottles_a9b0c2b0-2bf6-48a7-9f79-8079ab66965a.jpg",
            "caption": "",
            "heading": "How NOT to Use Our Logo",
            "text": "<p>To protect the integrity of our brand, please avoid the following:</p><ul><li><strong>Do not stretch or distort the logo.</strong></li><li><strong>Do not change the logo's colors.</strong> Only use the colors from the approved brand palette.</li><li><strong>Do not place the logo on a busy background</strong> without enough contrast for it to be read clearly. </li></ul><p></p><p>If you would like to sell our product under our brand name but using a different label format, please transfer the elements over as information text only. For example, instead of our logo just type out “Rustic Strength” and instead of the graphics just type “Lavender Hand Soap”. We recommend avoiding bold colors and sticking to neutral, desaturate, or understated color schemes for this set up.</p>",
            "button_label": "",
            "button_link": ""
          }
        }
      },
