<!doctype html>
<html class="js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="">
        {% if request.page_type == 'blog' %}
      {% assign noindex_blogs = 'news,tips-tricks,our-packaging,you-will-never-find-these-in-our-products,ingredients-we-stand-by,soap,company' | split: ',' %}
      {% if noindex_blogs contains blog.handle %}
        <meta name="robots" content="noindex, follow">
      {% endif %}
    {% endif %}
    {%- assign custom_canonical = article.metafields.custom.canonical_url.value -%}
    {%- if request.page_type == 'article' and custom_canonical != blank -%}
      <link rel="canonical" href="{{ custom_canonical | escape }}">
    {%- else -%}
      <link rel="canonical" href="{{ canonical_url | escape }}">
    {%- endif -%}


    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    {%- unless settings.type_header_font.system? and settings.type_body_font.system? -%}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {%- endunless -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {% render 'meta-tags' %}

    <script src="{{ 'constants.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'pubsub.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'global.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'details-disclosure.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'details-modal.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'search-form.js' | asset_url }}" defer="defer"></script>

    {%- if settings.animations_reveal_on_scroll -%}
      <script src="{{ 'animations.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}

    <!-- Meta Pixel & Beacon Event Suppression Proxy -->
    <script>
      (function () {
        try {
          if (sessionStorage.getItem('ws_flagged_spam') === 'true') {
            const blockedEvents = ['Lead', 'CompleteRegistration', 'Wholesale Application Submitted'];
            let activeFbq = window.fbq;

            const wrapFbq = (original) => {
              if (!original || original.isProxied) return original;

              const proxy = function () {
                const args = Array.prototype.slice.call(arguments);
                const eventName = args[1];

                if (blockedEvents.includes(eventName)) {
                  console.warn('Honeypot flag active: Suppressing conversion event:', eventName);
                  return;
                }

                return original.apply(this, arguments);
              };

              Object.assign(proxy, original);
              proxy.isProxied = true;
              return proxy;
            };

            if (activeFbq) {
              window.fbq = wrapFbq(activeFbq);
            } else {
              Object.defineProperty(window, 'fbq', {
                configurable: true,
                enumerable: true,
                get: function () {
                  return activeFbq;
                },
                set: function (newVal) {
                  activeFbq = wrapFbq(newVal);
                },
              });
            }

            let active_Fbq = window._fbq;
            if (active_Fbq) {
              window._fbq = wrapFbq(active_Fbq);
            } else {
              Object.defineProperty(window, '_fbq', {
                configurable: true,
                enumerable: true,
                get: function () {
                  return active_Fbq;
                },
                set: function (newVal) {
                  active_Fbq = wrapFbq(newVal);
                },
              });
            }

            const interceptQueue = (q) => {
              if (!q || q.isProxied) return q;

              const filtered = q.filter((item) => !blockedEvents.includes(item[1]));
              q.length = 0;
              filtered.forEach((item) => q.push(item));

              const originalPush = q.push;
              q.push = function () {
                const args = Array.prototype.slice.call(arguments);
                const eventName = args[1];
                if (blockedEvents.includes(eventName)) {
                  console.warn('Suppressed queued event:', eventName);
                  return;
                }
                return originalPush.apply(this, arguments);
              };
              q.isProxied = true;
              return q;
            };

            if (window.fbq && window.fbq.queue) {
              interceptQueue(window.fbq.queue);
            }

            const OriginalImage = window.Image;
            window.Image = function () {
              const img = new OriginalImage(...arguments);
              Object.defineProperty(img, 'src', {
                get: function () {
                  return img.getAttribute('src');
                },
                set: function (val) {
                  if (typeof val === 'string' && val.includes('facebook.com/tr') && val.includes('ev=Lead')) {
                    console.warn('Suppressed Image constructor Facebook Lead beacon:', val);
                    return;
                  }
                  img.setAttribute('src', val);
                },
              });
              return img;
            };

            const originalImageSrcDescriptor = Object.getOwnPropertyDescriptor(HTMLImageElement.prototype, 'src');
            if (originalImageSrcDescriptor && originalImageSrcDescriptor.set) {
              Object.defineProperty(HTMLImageElement.prototype, 'src', {
                get: function () {
                  return originalImageSrcDescriptor.get.call(this);
                },
                set: function (val) {
                  if (typeof val === 'string' && val.includes('facebook.com/tr') && val.includes('ev=Lead')) {
                    console.warn('Suppressed HTMLImageElement Facebook Lead beacon:', val);
                    return;
                  }
                  originalImageSrcDescriptor.set.call(this, val);
                },
              });
            }

            if (navigator.sendBeacon) {
              const originalSendBeacon = navigator.sendBeacon;
              navigator.sendBeacon = function (url) {
                if (typeof url === 'string' && url.includes('facebook.com/tr') && url.includes('ev=Lead')) {
                  console.warn('Suppressed sendBeacon Facebook Lead call:', url);
                  return true;
                }
                return originalSendBeacon.apply(this, arguments);
              };
            }

            if (window.fetch) {
              const originalFetch = window.fetch;
              window.fetch = function (input) {
                let url = '';
                if (typeof input === 'string') {
                  url = input;
                } else if (input && input.url) {
                  url = input.url;
                }
                if (url.includes('facebook.com/tr') && url.includes('ev=Lead')) {
                  console.warn('Suppressed fetch Facebook Lead call:', url);
                  return Promise.resolve(new Response('', { status: 200, statusText: 'OK' }));
                }
                return originalFetch.apply(this, arguments);
              };
            }
          }
        } catch (e) {
          console.error('Spam suppression proxy setup failed:', e);
        }
      })();
    </script>

    <script>
      (function () {
        const OriginalDateTimeFormat = Intl.DateTimeFormat;
        function normalizeTimezone(tz) {
          if (typeof tz !== 'string' && typeof tz !== 'number') return tz;
          const str = String(tz).trim();

          const match = str.match(/^([+-])?(\d{1,2})(?::(\d{2}))?$/);
          if (match) {
            const sign = match[1] === '+' ? '-' : '+';
            const hours = parseInt(match[2], 10);
            if (hours === 0) return 'UTC';
            return `Etc/GMT${sign}${hours}`;
          }
          return tz;
        }
        Intl.DateTimeFormat = function (locales, options) {
          if (options && options.timeZone) {
            const normalized = normalizeTimezone(options.timeZone);
            try {
              return new OriginalDateTimeFormat(locales, { ...options, timeZone: normalized });
            } catch (e) {
              const fallbackOptions = { ...options };
              delete fallbackOptions.timeZone;
              return new OriginalDateTimeFormat(locales, fallbackOptions);
            }
          }
          return new OriginalDateTimeFormat(locales, options);
        };
        Intl.DateTimeFormat.prototype = OriginalDateTimeFormat.prototype;
        Intl.DateTimeFormat.supportedLocalesOf = OriginalDateTimeFormat.supportedLocalesOf;
      })();
    </script>

    <script>
      (function () {
        const ANALYTICS_PATTERNS = [
          'google-analytics.com',
          'googletagmanager.com/gtag/destination',
          'googletagmanager.com/gtag/js?id=ua',
          'googletagmanager.com/gtag/js?id=g-',
          'static.hotjar.com/c/hotjar',
          'clarity.ms',
        ];

        const MARKETING_PATTERNS = [
          'connect.facebook.net',
          'facebook.com/tr',
          'googletagmanager.com/gtm.js',
          'googletagmanager.com/gtag/js?id=aw',
          'googletagmanager.com/gtag/js?id=gt-',
          'googleadservices.com',
          'googleads.g.doubleclick.net',
          'doubleclick.net',
          'google.com/ccm',
          'google.com/pagead',
          'pagead2.googlesyndication.com',
          'triplewhale.com',
          'js.go2sdk.com',
          'aspireiq.go2cloud.org',
          'attribution-guru',
          '/apps/ag/',
          'klaviyo.com',
          'analytics.tiktok.com',
          's.pinimg.com',
          'ct.pinterest.com',
          'redditstatic.com',
          'alb.reddit.com',
          'bat.bing.com',
          'pop-convert.com',
          'pop-convert-88',
          't.vibe.co',
          's.adroll.com',
          'static.ads-twitter.com',
          'intg.snapchat.com',
        ];

        const readStoredConsent = () => {
          try {
            const match = document.cookie.match(/(?:^|;\s*)_pandectes_gdpr=([^;]+)/);

            if (!match) {
              return null;
            }

            return JSON.parse(atob(decodeURIComponent(match[1])));
          } catch (e) {
            return null;
          }
        };

        const isExplicitAllow = (stored) =>
          Boolean(stored && stored.status === 'allow' && stored.method === 'explicit' && Number(stored.preferences) === 0);

        const pushDeniedGtag = () => {
          window.dataLayer = window.dataLayer || [];

          const gtagCall = function () {
            window.dataLayer.push(arguments);
          };

          gtagCall('consent', 'default', {
            ad_storage: 'denied',
            ad_user_data: 'denied',
            ad_personalization: 'denied',
            analytics_storage: 'denied',
            functionality_storage: 'denied',
            personalization_storage: 'denied',
            security_storage: 'granted',
          });

          gtagCall('consent', 'update', {
            ad_storage: 'denied',
            ad_user_data: 'denied',
            ad_personalization: 'denied',
            analytics_storage: 'denied',
            functionality_storage: 'denied',
            personalization_storage: 'denied',
            security_storage: 'granted',
          });
        };

        const writeGpcOptOutCookie = () => {
          const payload = {
            status: 'deny',
            timestamp: Math.floor(Date.now() / 1000),
            preferences: 7,
            method: 'explicit',
            version: '5',
            cookieDomain: '',
          };

          document.cookie =
            '_pandectes_gdpr=' +
            btoa(JSON.stringify(payload)) +
            '; path=/; max-age=31536000; SameSite=Lax';
        };

        const initialStored = readStoredConsent();
        const gpcActive = navigator.globalPrivacyControl === true;

        if (gpcActive && !isExplicitAllow(initialStored)) {
          if (!initialStored || Number(initialStored.preferences) !== 7) {
            writeGpcOptOutCookie();
          }

          pushDeniedGtag();
        }

        const getDeniedCategoryForUrl = (rawUrl) => {
          if (!rawUrl || typeof rawUrl !== 'string') {
            return 0;
          }

          const stored = readStoredConsent();

          if (!stored) {
            if (gpcActive) {
              const lu = rawUrl.toLowerCase();

              if (MARKETING_PATTERNS.some((p) => lu.includes(p))) {
                return 4;
              }

              if (ANALYTICS_PATTERNS.some((p) => lu.includes(p))) {
                return 2;
              }
            }

            return 0;
          }

          const prefs = Number(stored.preferences);

          if (!Number.isFinite(prefs) || prefs === 0) {
            return 0;
          }

          const lu = rawUrl.toLowerCase();

          if ((prefs & 4) !== 0 && MARKETING_PATTERNS.some((p) => lu.includes(p))) {
            return 4;
          }

          if ((prefs & 2) !== 0 && ANALYTICS_PATTERNS.some((p) => lu.includes(p))) {
            return 2;
          }

          return 0;
        };

        if (!getDeniedCategoryForUrl('https://connect.facebook.net') && !getDeniedCategoryForUrl('https://google-analytics.com')) {
          return;
        }

        const blockScriptNode = (node) => {
          if (!node || node.nodeType !== 1) {
            return;
          }

          if (node.tagName === 'SCRIPT') {
            const src = node.getAttribute('src') || node.src || '';
            const category = getDeniedCategoryForUrl(src);

            if (category) {
              node.type = 'javascript/blocked';
              node.setAttribute('data-cookiecategory', String(category));
              node.setAttribute('data-src', src);
              node.removeAttribute('src');
            }
          }
        };

        const observer = new MutationObserver((mutations) => {
          for (const mutation of mutations) {
            for (const node of mutation.addedNodes) {
              blockScriptNode(node);
            }
          }
        });

        observer.observe(document, { childList: true, subtree: true });

        const origCreateElement = document.createElement;
        document.createElement = function (tagName, options) {
          const el = origCreateElement.call(document, tagName, options);

          if (String(tagName).toLowerCase() === 'script') {
            const desc = Object.getOwnPropertyDescriptor(HTMLScriptElement.prototype, 'src');

            if (desc && desc.set) {
              try {
                Object.defineProperty(el, 'src', {
                  set(val) {
                    const category = getDeniedCategoryForUrl(String(val));

                    if (category) {
                      el.type = 'javascript/blocked';
                      el.setAttribute('data-cookiecategory', String(category));
                      el.setAttribute('data-src', String(val));
                      return;
                    }

                    desc.set.call(el, val);
                  },
                  get: desc.get,
                  configurable: true,
                });
              } catch (e) {}
            }
          }

          return el;
        };

        const imgDesc = Object.getOwnPropertyDescriptor(HTMLImageElement.prototype, 'src');

        if (imgDesc && imgDesc.set) {
          try {
            Object.defineProperty(HTMLImageElement.prototype, 'src', {
              set(val) {
                if (getDeniedCategoryForUrl(String(val))) {
                  return;
                }

                imgDesc.set.call(this, val);
              },
              get: imgDesc.get,
              configurable: true,
            });
          } catch (e) {}
        }

        const origFetch = window.fetch;

        if (origFetch) {
          window.fetch = function (input, init) {
            const url = typeof input === 'string' ? input : input?.url || '';

            if (getDeniedCategoryForUrl(url)) {
              return Promise.resolve(new Response('', { status: 204 }));
            }

            return origFetch.call(this, input, init);
          };
        }

        const origXhrOpen = XMLHttpRequest.prototype.open;
        const origXhrSend = XMLHttpRequest.prototype.send;

        XMLHttpRequest.prototype.open = function (method, url, ...rest) {
          this._rsConsentBlocked = Boolean(getDeniedCategoryForUrl(String(url)));
          return origXhrOpen.call(this, method, url, ...rest);
        };

        XMLHttpRequest.prototype.send = function (body) {
          if (this._rsConsentBlocked) {
            return;
          }

          return origXhrSend.call(this, body);
        };

        if (typeof navigator.sendBeacon === 'function') {
          const origBeacon = navigator.sendBeacon.bind(navigator);

          navigator.sendBeacon = function (url, data) {
            if (getDeniedCategoryForUrl(String(url))) {
              return true;
            }

            return origBeacon(url, data);
          };
        }
      })();
    </script>

    {{ content_for_header }}

    {%- liquid
      assign body_font_bold = settings.type_body_font | font_modify: 'weight', 'bold'
      assign body_font_italic = settings.type_body_font | font_modify: 'style', 'italic'
      assign body_font_bold_italic = body_font_bold | font_modify: 'style', 'italic'
    %}

    {% style %}
      {{ settings.type_body_font | font_face: font_display: 'swap' }}
      {{ body_font_bold | font_face: font_display: 'swap' }}
      {{ body_font_italic | font_face: font_display: 'swap' }}
      {{ body_font_bold_italic | font_face: font_display: 'swap' }}
      {{ settings.type_header_font | font_face: font_display: 'swap' }}

      {% for scheme in settings.color_schemes -%}
        {% assign scheme_classes = scheme_classes | append: ', .color-' | append: scheme.id %}
        {% if forloop.index == 1 -%}
          :root,
        {%- endif %}
        .color-{{ scheme.id }} {
          --color-background: {{ scheme.settings.background.red }},{{ scheme.settings.background.green }},{{ scheme.settings.background.blue }};
        {% if scheme.settings.background_gradient != empty %}
          --gradient-background: {{ scheme.settings.background_gradient }};
        {% else %}
          --gradient-background: {{ scheme.settings.background }};
        {% endif %}

        {% liquid
          assign background_color = scheme.settings.background
          assign background_color_brightness = background_color | color_brightness
          if background_color_brightness <= 26
            assign background_color_contrast = background_color | color_lighten: 50
          elsif background_color_brightness <= 65
            assign background_color_contrast = background_color | color_lighten: 5
          else
            assign background_color_contrast = background_color | color_darken: 25
          endif
        %}

        --color-foreground: {{ scheme.settings.text.red }},{{ scheme.settings.text.green }},{{ scheme.settings.text.blue }};
        --color-background-contrast: {{ background_color_contrast.red }},{{ background_color_contrast.green }},{{ background_color_contrast.blue }};
        --color-shadow: {{ scheme.settings.shadow.red }},{{ scheme.settings.shadow.green }},{{ scheme.settings.shadow.blue }};
        --color-button: {{ scheme.settings.button.red }},{{ scheme.settings.button.green }},{{ scheme.settings.button.blue }};
        --color-button-text: {{ scheme.settings.button_label.red }},{{ scheme.settings.button_label.green }},{{ scheme.settings.button_label.blue }};
        --color-secondary-button: {{ scheme.settings.background.red }},{{ scheme.settings.background.green }},{{ scheme.settings.background.blue }};
        --color-secondary-button-text: {{ scheme.settings.secondary_button_label.red }},{{ scheme.settings.secondary_button_label.green }},{{ scheme.settings.secondary_button_label.blue }};
        --color-link: {{ scheme.settings.secondary_button_label.red }},{{ scheme.settings.secondary_button_label.green }},{{ scheme.settings.secondary_button_label.blue }};
        --color-badge-foreground: {{ scheme.settings.text.red }},{{ scheme.settings.text.green }},{{ scheme.settings.text.blue }};
        --color-badge-background: {{ scheme.settings.background.red }},{{ scheme.settings.background.green }},{{ scheme.settings.background.blue }};
        --color-badge-border: {{ scheme.settings.text.red }},{{ scheme.settings.text.green }},{{ scheme.settings.text.blue }};
        --payment-terms-background-color: rgb({{ scheme.settings.background.rgb }});
      }
      {% endfor %}

      {{ scheme_classes | prepend: 'body' }} {
        color: rgba(var(--color-foreground), 0.75);
        background-color: rgb(var(--color-background));
      }

      :root {
        --font-body-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
        --font-body-style: {{ settings.type_body_font.style }};
        --font-body-weight: {{ settings.type_body_font.weight }};
        --font-body-weight-bold: {{ settings.type_body_font.weight | plus: 300 | at_most: 1000 }};

        --font-heading-family: {{ settings.type_header_font.family }}, {{ settings.type_header_font.fallback_families }};
        --font-heading-style: {{ settings.type_header_font.style }};
        --font-heading-weight: {{ settings.type_header_font.weight }};

        --font-body-scale: {{ settings.body_scale | divided_by: 100.0 }};
        --font-heading-scale: {{ settings.heading_scale | times: 1.0 | divided_by: settings.body_scale }};

