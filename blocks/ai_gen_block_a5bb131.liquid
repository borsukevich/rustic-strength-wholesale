{% doc %}
  @prompt
    A section that would allow for 3-6 image icons to be listed horizontally with rich text that can be placed above or below. Allow for customizing the padding on top and bottom and for the block to be customized with a color scheme

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-icon-features-{{ ai_gen_id }} {
    padding-top: {{ block.settings.padding_top }}px;
    padding-bottom: {{ block.settings.padding_bottom }}px;
    padding-left: 20px;
    padding-right: 20px;
  }

  .ai-icon-features__container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-icon-features__text-{{ ai_gen_id }} {
    margin-bottom: 40px;
    text-align: center;
  }

  .ai-icon-features__text-{{ ai_gen_id }}.bottom {
    margin-bottom: 0;
    margin-top: 40px;
  }

  .ai-icon-features__icons-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.icons_count }}, 1fr);
    gap: 30px;
    align-items: center;
  }

  .ai-icon-features__icon-item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 15px;
  }

  .ai-icon-features__icon-wrapper-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .ai-icon-features__icon-wrapper-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ai-icon-features__icon-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-icon-features__icon-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.5;
  }

  .ai-icon-features__icon-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 600;
    margin: 0;
    line-height: 1.3;
  }

  .ai-icon-features__icon-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    line-height: 1.4;
    margin: 0;
  }

  @media screen and (max-width: 990px) {
    .ai-icon-features__icons-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_tablet }}, 1fr);
      gap: 25px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-icon-features__icons-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
      gap: 20px;
    }

    .ai-icon-features__icon-wrapper-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size | times: 0.8 }}px;
      height: {{ block.settings.icon_size | times: 0.8 }}px;
    }

    .ai-icon-features__text-{{ ai_gen_id }} {
      margin-bottom: 30px;
    }

    .ai-icon-features__text-{{ ai_gen_id }}.bottom {
      margin-top: 30px;
    }
  }
{% endstyle %}

<div 
  class="ai-icon-features-{{ ai_gen_id }} color-{{ block.settings.color_scheme }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-icon-features__container-{{ ai_gen_id }}">
    {% if block.settings.text_position == 'above' and block.settings.rich_text != blank %}
      <div class="ai-icon-features__text-{{ ai_gen_id }}">
        {{ block.settings.rich_text }}
      </div>
    {% endif %}<div class="ai-icon-features__icons-grid-{{ ai_gen_id }}">
      {% for i in (1..6) %}
        {% if i <= block.settings.icons_count %}
          {% liquid
            assign icon_key = 'icon_' | append: i
            assign title_key = 'title_' | append: i
            assign description_key = 'description_' | append: i
            
            assign icon = block.settings[icon_key]
            assign title = block.settings[title_key]
            assign description = block.settings[description_key]
          %}
          
          <div class="ai-icon-features__icon-item-{{ ai_gen_id }}">
            <div class="ai-icon-features__icon-wrapper-{{ ai_gen_id }}">
              {% if icon %}
                <img
                  src="{{ icon | image_url: width: 200 }}"
                  alt="{{ icon.alt | escape }}"
                  loading="lazy"
                  width="{{ block.settings.icon_size }}"
                  height="{{ block.settings.icon_size }}"
                >
              {% else %}
                <div class="ai-icon-features__icon-placeholder-{{ ai_gen_id }}">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>
            
            {% if title != blank %}
              <h3 class="ai-icon-features__icon-title-{{ ai_gen_id }}">{{ title }}</h3>
            {% endif %}
            
            {% if description != blank %}
              <div class="ai-icon-features__icon-description-{{ ai_gen_id }}">{{ description }}</div>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>

    {% if block.settings.text_position == 'below' and block.settings.rich_text != blank %}
      <div class="ai-icon-features__text-{{ ai_gen_id }} bottom">
        {{ block.settings.rich_text }}
      </div>
    {% endif %}
  </div>
</div>

