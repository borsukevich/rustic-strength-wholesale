        "collapsible_row_D6kCn7": {
          "type": "collapsible_row",
          "settings": {
            "heading": "I forgot to sign in and just made a purchase, will I still earn points for my order?",
            "icon": "check_mark",
            "row_content": "<p>To ensure that you will accrue points correctly, please make sure the same email address is used for your payment method an your Rewards account. We do recommend being logged in to one single account for purchases in order to ensure orders are counted towards your Tier status. </p>",
            "page": ""
          }
        },
        "collapsible_row_4jMK7M": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What happens to my points if I return a product or an order is cancelled?",
            "icon": "check_mark",
            "row_content": "<p>Any product that is returned or any order that is cancelled will reverse or decrease the points you received from that purchase. If you moved up a tier on that order, your tier will also be adjusted accordingly.</p>",
            "page": ""
          }
        }
