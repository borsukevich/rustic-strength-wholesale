  ],
  "presets": [
    {
      "name": "Lab Results Growth Intake",
      "blocks": [
        {
          "type": "tag_row",
          "settings": {
            "label": "Next screens",
            "tags": "Phthalates; 1,4-dioxane; Parabens"
