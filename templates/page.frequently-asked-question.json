        "collapsible_row_bcLPQW": {
          "type": "collapsible_row",
          "settings": {
            "heading": "How do I sign up for Email + SMS?",
            "icon": "check_mark",
            "row_content": "<p>If you didn't sign up when you created your account, but would like to receive the updates, you can sign up at checkout by simply clicking on the option(s) you would like. The email that is associated with your account will be signed up. We offer discounts and perks to our subscribers!</p><p>You will also receive the Points Rewards associated with signing up. They will be automatically added to your account within 24 hours.</p>",
            "page": ""
          }
        }
