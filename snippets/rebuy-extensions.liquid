<style>
  #rebuy-quick-view-dropdown-search,
  [id="rebuy-quick-view-dropdown-search"],
  .rebuy-quick-view-dropdown-search,
  .rebuy-search-dropdown {
    display: none !important;
    visibility: hidden !important;
    opacity: 0 !important;
    pointer-events: none !important;
    height: 0 !important;
    width: 0 !important;
    overflow: hidden !important;
  }

  {%- if request.page_type == 'search' -%}
    .template-search__header,
    .template-search__search,
    .template-search #product-grid,
    .template-search .template-search__results {
      display: none !important;
    }

    #rebuy-smart-search-results-dropdown,
    [id="rebuy-smart-search-results-dropdown"],
    [id*="rebuy-smart-search"],
    .rebuy-smart-search-results-dropdown {
      display: block !important;
      visibility: visible !important;
      opacity: 1 !important;
      pointer-events: auto !important;
      height: auto !important;
      width: 100% !important;
      max-width: 1200px !important;
      margin: 2rem auto !important;
      padding-top: 1px !important;
      padding-bottom: 30px !important;
      padding-left: 1.5rem !important;
      padding-right: 1.5rem !important;
      position: relative !important;
      overflow: visible !important;
    }

    .rebuy-smart-search-results-page-dropdown__input {
      padding-top: 10px !important;
      padding-bottom: 10px !important;
    }

    .rebuy-search-filter i {
      margin-left: 10px;
      transform: translateY(1px);
    }

    #rebuy-smart-search-sort-options {
      margin-top: 10px !important;
      background-position: calc(100% - 13px) calc(0.85em + 2px), calc(100% - 8px) calc(0.85em + 2px), calc(100% - -0.1em) 0.5em;
      padding: 5px 10px !important;
    }

    .rebuy-smart-search-results-page-dropdown__sort-by-label {
      color: rgb(var(--color-foreground)) !important;
    }
  {%- else -%}
    #rebuy-smart-search-results-dropdown,
    [id="rebuy-smart-search-results-dropdown"],
    .rebuy-smart-search-results-dropdown {
      display: none !important;
      visibility: hidden !important;
      opacity: 0 !important;
      pointer-events: none !important;
    }
  {%- endif -%}
</style>
<script>
  function updateSearchPrices(products, type) {
    setTimeout(() => {
      products.forEach(product => {
        fetch(Shopify.routes.root + "products/" + product.handle + ".js")
          .then((res) => res.json())
          .then((data) => {
            var updatedProductData = data;
            if (Number(product.id) === updatedProductData.id || product.productId === updatedProductData.id) {
              product.price = updatedProductData.price;
              product.compareAtPrice = updatedProductData.compare_at_price;
              if (product.variants) {
                for (var j = 0, updatedProductVariant; j < updatedProductData.variants?.length; j++) {
                  updatedProductVariant = updatedProductData.variants[j];
                  for (var x = 0, productVariant; x < product.variants?.length; x++) {
                    productVariant = product.variants[x];
                    if (updatedProductVariant.id === Number(productVariant.id)) {
                      productVariant.price = updatedProductVariant.price;
                      productVariant.compareAtPrice = updatedProductVariant.compare_at_price;
                      break;
                    }
                  }
                }
              } else {
                product.selected_variant.price = updatedProductData.price;
                product.selected_variant.compareAtPrice = updatedProductData.compare_at_price;
              }
            }
          });
      })
    }, 500)
  }

  document.addEventListener('rebuy:smartsearch.quickview.ready', (event) => {
    setTimeout(() => { updateSearchPrices(event.detail.smartSearchQuickView.setting.suggestedProducts, "QUICKVIEW ready"); }, 500)
  });
  document.addEventListener('rebuy:smartsearch.quickview.productsChange', (event) => {
    updateSearchPrices(event.detail.products, "QUICKVIEW change");
  });
  document.addEventListener('rebuy:smartsearch.resultsPage.productsChange', (event) => {
    setTimeout(() => { updateSearchPrices(event.detail.products, "RESULTSPAGE"); }, 500)
  });
</script>