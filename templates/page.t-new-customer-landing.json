    "multicolumn_HPXGDK": {
      "type": "multicolumn",
      "blocks": {
        "column_43abpW": {
          "type": "column",
          "settings": {
            "title": "Expert Insight",
            "text": "<p>We formulate and manufacture all our products, so we have unmatched knowledge of our ingredients and how they work together. This means you can rely on us to solve any ingredient challenge or question to help you achieve your best possible results.</p>",
            "link_label": "",
            "link": ""
          }
        },
        "column_A44bTx": {
          "type": "column",
          "settings": {
            "title": "Zero-Waste Solutions",
            "text": "<p>At Rustic Strength, we focus on everyday essentials your customers actually need—like our best-selling laundry detergent. Thanks to our pioneering Close the Loop Program, and the support of partners like you, empty containers are returned, sanitized, refilled, and reused. Together we are reducing waste and protecting our planet.</p>",
            "link_label": "",
            "link": ""
          }
        },
        "column_mjA3Ec": {
          "type": "column",
          "settings": {
            "title": "Natural that <em>truly</em> works",
            "text": "<p>Customers often say, <em>“I tried natural brand after natural brand, but nothing worked until Rustic Strength.”</em> Our plant- and mineral-based formulas are packed with active ingredients, never cheap fillers, and always free from harsh chemicals still found in many “eco-friendly” brands. Every product is <em>toxin-free, worry-free </em>and 100% biodegradable, septic- and greywater-safe.</p>",
            "link_label": "",
            "link": ""
          }
        }
      },
      "block_order": [
        "column_43abpW",
        "column_A44bTx",
        "column_mjA3Ec"
      ],
