{% doc %}
  @prompt
    Create a section that can have up to 6 videos on a carousel. The videos should have the option of text overlay with or without a container. The size should be adjustable.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-video-carousel-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    position: relative;
    overflow: hidden;
  }

  .ai-video-carousel__track-{{ ai_gen_id }} {
    display: flex;
    transition: transform 0.5s ease;
    gap: {{ block.settings.gap }}px;
  }

  .ai-video-carousel__slide-{{ ai_gen_id }} {
    flex: 0 0 100%;
    position: relative;
    aspect-ratio: {{ block.settings.aspect_ratio }};
    background-color: #000000;
  }

  .ai-video-carousel__video-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-video-carousel__overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: {{ block.settings.text_vertical_alignment }};
    justify-content: {{ block.settings.text_horizontal_alignment }};
    padding: 20px;
    pointer-events: none;
  }

  .ai-video-carousel__text-container-{{ ai_gen_id }} {
    {% if block.settings.show_text_container %}
      background-color: {{ block.settings.container_background_color }};
      padding: {{ block.settings.container_padding }}px;
      border-radius: {{ block.settings.container_border_radius }}px;
    {% endif %}
    max-width: 90%;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-video-carousel__heading-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.heading_size }}px;
    margin: 0 0 8px 0;
    line-height: 1.2;
  }

  .ai-video-carousel__subtext-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.subtext_size }}px;
    margin: 0;
    line-height: 1.4;
  }

  .ai-video-carousel__controls-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 12px;
    align-items: center;
    z-index: 10;
  }

  .ai-video-carousel__nav-button-{{ ai_gen_id }} {
    background-color: {{ block.settings.nav_button_color }};
    color: {{ block.settings.nav_button_icon_color }};
    border: none;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.3s ease;
  }

  .ai-video-carousel__nav-button-{{ ai_gen_id }}:hover {
    opacity: 0.8;
  }

  .ai-video-carousel__nav-button-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-video-carousel__dots-{{ ai_gen_id }} {
    display: flex;
    gap: 8px;
  }

  .ai-video-carousel__dot-{{ ai_gen_id }} {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_color }};
    opacity: 0.5;
    border: none;
    cursor: pointer;
    padding: 0;
    transition: opacity 0.3s ease;
  }

  .ai-video-carousel__dot-{{ ai_gen_id }}.active {
    opacity: 1;
  }

  .ai-video-carousel__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-video-carousel__placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
  }

  .ai-video-carousel__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  @media screen and (max-width: 749px) {
    .ai-video-carousel__heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }

    .ai-video-carousel__subtext-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.subtext_size }}px * 0.8);
    }

    .ai-video-carousel__text-container-{{ ai_gen_id }} {
      {% if block.settings.show_text_container %}
        padding: calc({{ block.settings.container_padding }}px * 0.7);
      {% endif %}
    }
  }
{% endstyle %}

<video-carousel-{{ ai_gen_id }}
  class="ai-video-carousel-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-video-carousel__track-{{ ai_gen_id }}">
    {% for i in (1..6) %}
      {% liquid
        assign video_key = 'video_' | append: i
        assign heading_key = 'heading_' | append: i
        assign subtext_key = 'subtext_' | append: i
        assign video = block.settings[video_key]
        assign heading = block.settings[heading_key]
        assign subtext = block.settings[subtext_key]
      %}

      {% if video != blank %}
        <div class="ai-video-carousel__slide-{{ ai_gen_id }}" data-slide="{{ i }}">
          <video
            class="ai-video-carousel__video-{{ ai_gen_id }}"
            src="{{ video.sources[1].url }}"
            {% if block.settings.autoplay %}autoplay{% endif %}
            {% if block.settings.loop %}loop{% endif %}
            {% if block.settings.muted %}muted{% endif %}
            playsinline
          ></video>

          {% if heading != blank or subtext != blank %}
            <div class="ai-video-carousel__overlay-{{ ai_gen_id }}">
              <div class="ai-video-carousel__text-container-{{ ai_gen_id }}">
                {% if heading != blank %}
                  <h2 class="ai-video-carousel__heading-{{ ai_gen_id }}">{{ heading }}</h2>
                {% endif %}
                {% if subtext != blank %}
                  <p class="ai-video-carousel__subtext-{{ ai_gen_id }}">{{ subtext }}</p>
                {% endif %}
              </div>
            </div>
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}

    {% assign has_video = false %}
    {% for i in (1..6) %}
      {% liquid
        assign video_key = 'video_' | append: i
        assign video = block.settings[video_key]
      %}
      {% if video != blank %}
        {% assign has_video = true %}
        {% break %}
      {% endif %}
    {% endfor %}

    {% unless has_video %}
      <div class="ai-video-carousel__slide-{{ ai_gen_id }}">
        <div class="ai-video-carousel__placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
          <div class="ai-video-carousel__empty-state-{{ ai_gen_id }}">
            Next, add videos to your carousel
          </div>
        </div>
      </div>
    {% endunless %}
  </div>

  {% if has_video %}
    <div class="ai-video-carousel__controls-{{ ai_gen_id }}">
      <button
        class="ai-video-carousel__nav-button-{{ ai_gen_id }} ai-video-carousel__prev-{{ ai_gen_id }}"
        aria-label="Previous video"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      <div class="ai-video-carousel__dots-{{ ai_gen_id }}"></div>

      <button
        class="ai-video-carousel__nav-button-{{ ai_gen_id }} ai-video-carousel__next-{{ ai_gen_id }}"
        aria-label="Next video"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>
  {% endif %}
</video-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class VideoCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentSlide = 0;
        this.slides = [];
      }

      connectedCallback() {
        this.track = this.querySelector('.ai-video-carousel__track-{{ ai_gen_id }}');
        this.slides = Array.from(this.querySelectorAll('.ai-video-carousel__slide-{{ ai_gen_id }}[data-slide]'));
        this.prevButton = this.querySelector('.ai-video-carousel__prev-{{ ai_gen_id }}');
        this.nextButton = this.querySelector('.ai-video-carousel__next-{{ ai_gen_id }}');
        this.dotsContainer = this.querySelector('.ai-video-carousel__dots-{{ ai_gen_id }}');

        if (this.slides.length === 0) return;

        this.createDots();
        this.setupEventListeners();
        this.updateCarousel();
      }

      createDots() {
        this.slides.forEach((slide, index) => {
          const dot = document.createElement('button');
          dot.className = 'ai-video-carousel__dot-{{ ai_gen_id }}';
          dot.setAttribute('aria-label', `Go to video ${index + 1}`);
          dot.addEventListener('click', () => this.goToSlide(index));
          this.dotsContainer.appendChild(dot);
        });
      }

      setupEventListeners() {
        if (this.prevButton) {
          this.prevButton.addEventListener('click', () => this.previousSlide());
        }
        if (this.nextButton) {
          this.nextButton.addEventListener('click', () => this.nextSlide());
        }
      }

      goToSlide(index) {
        this.currentSlide = index;
        this.updateCarousel();
      }

      previousSlide() {
        this.currentSlide = Math.max(0, this.currentSlide - 1);
        this.updateCarousel();
      }

      nextSlide() {
        this.currentSlide = Math.min(this.slides.length - 1, this.currentSlide + 1);
        this.updateCarousel();
      }

      updateCarousel() {
        const gap = {{ block.settings.gap }};
        const slideWidth = this.slides[0].offsetWidth;
        const offset = -(this.currentSlide * (slideWidth + gap));
        this.track.style.transform = `translateX(${offset}px)`;

        const dots = this.dotsContainer.querySelectorAll('.ai-video-carousel__dot-{{ ai_gen_id }}');
        dots.forEach((dot, index) => {
          if (index === this.currentSlide) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });

        if (this.prevButton) {
          this.prevButton.disabled = this.currentSlide === 0;
        }
        if (this.nextButton) {
          this.nextButton.disabled = this.currentSlide === this.slides.length - 1;
        }
      }
    }

    customElements.define('video-carousel-{{ ai_gen_id }}', VideoCarousel{{ ai_gen_id }});
  })();
</script>

