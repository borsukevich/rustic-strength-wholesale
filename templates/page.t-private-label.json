    "image_with_text_ajnedc": {
      "type": "image-with-text",
      "blocks": {
        "heading_gTmARX": {
          "type": "heading",
          "settings": {
            "heading": "<strong>Creating your own brand</strong>",
            "heading_size": "h2"
          }
        },
        "text_KaKG9D": {
          "type": "text",
          "settings": {
            "text": "<p>We ask that you respect the work put into our brand by NOT making any modifications to our labels. If you are in the process of designing a label used to sell our products, please do not reuse any element of our original labels, including the logo. If you have a specific creative direction in mind that significantly deviates from ours, we recommend fully following it through and creating your own brand name and logo to accompany it.</p><p>If our name is not associated with the products we sell you (meaning you are selling them under your own brand and company) you have complete freedom of design. This is your business, and as long as the Rustic Strength brand name is not mentioned you can create any design you please! </p><p>The manufacturer information would simply need to state, “manufactured for MyNewBusiness”. </p><p>You can learn more about the legal requirements of cosmetic labeling here: <br/><br/></p>",
            "text_style": "body"
          }
        },
        "button_bDkqd9": {
          "type": "button",
          "settings": {
            "button_label": "FDA Label Requirements",
            "button_link": "https://www.fda.gov/cosmetics/cosmetics-labeling-regulations/cosmetics-labeling-guide",
            "button_style_secondary": false
          }
        }
      },
