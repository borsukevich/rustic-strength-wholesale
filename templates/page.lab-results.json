        "text_WaGdRU": {
          "type": "text",
          "settings": {
            "text": "<p>*None detected means below the lab's detection limit, which is not the same as a flat zero. ppm and mg per square decimeter are units of concentration. For scale, one drop of water in an Olympic pool is about 0.01 ppm.</p>"
          }
