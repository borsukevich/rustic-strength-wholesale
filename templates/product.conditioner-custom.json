        "collapsible-row-1": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Directions",
            "icon": "washing",
            "content": "<p>Pump desired amount (dependent on hair length) onto palm of hand. Spread conditioner on hands then, starting at the crown of head, swipe hands down to the end of hair line. </p><p>Apply more to ends if needed. For best results, let it it sit for a few minutes. </p><p>Rinse completely out of hair.</p>",
            "page": ""
          }
