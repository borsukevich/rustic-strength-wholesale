{% doc %}
  @prompt
    create a section that allows the addition of 1-3 rich text blocks. The section should also have 1-3 blocks that contain number counters. Make the number counters display horizontally as columns with image option above and text option below.

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-content-section-{{ ai_gen_id }} {
    padding: {{ block.settings.section_padding }}px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-content-section__container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-content-section__rich-text-{{ ai_gen_id }} {
    margin-bottom: {{ block.settings.spacing_between_sections }}px;
  }

  .ai-content-section__rich-text-item-{{ ai_gen_id }} {
    margin-bottom: 24px;
    color: {{ block.settings.text_color }};
  }

  .ai-content-section__rich-text-item-{{ ai_gen_id }}:last-child {
    margin-bottom: 0;
  }

  .ai-content-section__counters-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: {{ block.settings.counter_spacing }}px;
  }

  .ai-content-section__counter-{{ ai_gen_id }} {
    text-align: center;
    padding: 24px;
    background-color: {{ block.settings.counter_background_color }};
    border-radius: {{ block.settings.counter_border_radius }}px;
    border: {{ block.settings.counter_border_width }}px solid {{ block.settings.counter_border_color }};
  }

  .ai-content-section__counter-image-{{ ai_gen_id }} {
    width: {{ block.settings.counter_image_size }}px;
    height: {{ block.settings.counter_image_size }}px;
    margin: 0 auto 16px;
    border-radius: 50%;
    overflow: hidden;
  }

  .ai-content-section__counter-image-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-content-section__counter-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
  }

  .ai-content-section__counter-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.5;
  }

  .ai-content-section__counter-number-{{ ai_gen_id }} {
    font-size: {{ block.settings.counter_number_size }}px;
    font-weight: 700;
    color: {{ block.settings.counter_number_color }};
    margin-bottom: 8px;
    line-height: 1;
  }

  .ai-content-section__counter-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.counter_text_size }}px;
    color: {{ block.settings.counter_text_color }};
    line-height: 1.4;
  }

  @media screen and (max-width: 768px) {
    .ai-content-section__counters-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .ai-content-section__counter-number-{{ ai_gen_id }} {
      font-size: {{ block.settings.counter_number_size | times: 0.8 }}px;
    }
  }
{% endstyle %}<div class="ai-content-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-content-section__container-{{ ai_gen_id }}">
    {% if block.settings.rich_text_1 != blank or block.settings.rich_text_2 != blank or block.settings.rich_text_3 != blank %}
      <div class="ai-content-section__rich-text-{{ ai_gen_id }}">
        {% if block.settings.rich_text_1 != blank %}
          <div class="ai-content-section__rich-text-item-{{ ai_gen_id }}">
            {{ block.settings.rich_text_1 }}
          </div>
        {% endif %}
        
        {% if block.settings.rich_text_2 != blank %}
          <div class="ai-content-section__rich-text-item-{{ ai_gen_id }}">
            {{ block.settings.rich_text_2 }}
          </div>
        {% endif %}
        
        {% if block.settings.rich_text_3 != blank %}
          <div class="ai-content-section__rich-text-item-{{ ai_gen_id }}">
            {{ block.settings.rich_text_3 }}
          </div>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-content-section__counters-{{ ai_gen_id }}">
      {% for i in (1..3) %}
        {% liquid
          assign counter_enabled_key = 'counter_' | append: i | append: '_enabled'
          assign counter_image_key = 'counter_' | append: i | append: '_image'
          assign counter_number_key = 'counter_' | append: i | append: '_number'
          assign counter_text_key = 'counter_' | append: i | append: '_text'
          assign counter_enabled = block.settings[counter_enabled_key]
          assign counter_image = block.settings[counter_image_key]
          assign counter_number = block.settings[counter_number_key]
          assign counter_text = block.settings[counter_text_key]
        %}

        {% if counter_enabled %}
          <div class="ai-content-section__counter-{{ ai_gen_id }}">
            <div class="ai-content-section__counter-image-{{ ai_gen_id }}">
              {% if counter_image %}
                <img
                  src="{{ counter_image | image_url: width: 200 }}"
                  alt="{{ counter_image.alt | escape }}"
                  loading="lazy"
                  width="200"
                  height="200"
                >
              {% else %}
                <div class="ai-content-section__counter-image-placeholder-{{ ai_gen_id }}">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>
            
            {% if counter_number != blank %}
              <div class="ai-content-section__counter-number-{{ ai_gen_id }}">
                {{ counter_number }}
              </div>
            {% endif %}
            
            {% if counter_text != blank %}
              <div class="ai-content-section__counter-text-{{ ai_gen_id }}">
                {{ counter_text }}
              </div>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

