        const replacePriceText = () => {
          const prices = document.querySelectorAll('.rebuy-product-price .rebuy-money');

          prices.forEach(price => {
            const priceContainer = price.closest('.rebuy-product-price');

            if (priceContainer && !priceContainer.classList.contains('wholesale-hidden')) {
              priceContainer.innerHTML = '<a href="{{ routes.account_login_url }}" class="login-link-price">Please login for pricing</a>';
              priceContainer.classList.add('wholesale-hidden');
            }
          });
        };

        let debounceTimer;
        const observer = new MutationObserver((mutations) => {
          let hasNewNodes = false;

          mutations.forEach((mutation) => {
            if (mutation.addedNodes.length > 0) {
              hasNewNodes = true;
            }
          });

          if (hasNewNodes) {
            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(() => {
              replacePriceText();
            }, 100);
          }
        });

        observer.observe(document.body, {
          childList: true,
          subtree: true
        });

        replacePriceText();
      })();
    </script>

