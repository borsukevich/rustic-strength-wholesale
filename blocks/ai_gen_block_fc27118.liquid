{% doc %}
  @prompt
    Create a section that is exactly the same as the multicolumn section option available. Add the ability to use video instead of image. Add sizing options for the columns 1:1, 2:3, make sure that video files can be added (mp4, gif, mov)
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-multicolumn-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-multicolumn-container-{{ ai_gen_id }} {
    padding: {{ block.settings.padding_top }}px 0 {{ block.settings.padding_bottom }}px;
  }

  .ai-multicolumn-inner-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-multicolumn-heading-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin-bottom: {{ block.settings.heading_spacing }}px;
  }

  .ai-multicolumn-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    margin: 0;
    color: {{ block.settings.heading_color }};
  }

  .ai-multicolumn-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.column_gap }}px;
    margin-top: {{ block.settings.content_spacing }}px;
  }

  .ai-multicolumn-item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-multicolumn-media-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: {{ block.settings.media_radius }}px;
    margin-bottom: {{ block.settings.media_spacing }}px;
  }

  .ai-multicolumn-media-wrapper-{{ ai_gen_id }}::before {
    content: '';
    display: block;
    {% if block.settings.aspect_ratio == '1_1' %}
      padding-top: 100%;
    {% elsif block.settings.aspect_ratio == '2_3' %}
      padding-top: 150%;
    {% endif %}
  }

  .ai-multicolumn-media-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-multicolumn-video-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-multicolumn-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-multicolumn-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-multicolumn-item-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.item_heading_size }}px;
    margin: 0 0 {{ block.settings.item_heading_spacing }}px;
    color: {{ block.settings.item_heading_color }};
  }

  .ai-multicolumn-item-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.item_text_size }}px;
    line-height: 1.6;
    color: {{ block.settings.item_text_color }};
    margin: 0;
  }

  @media screen and (max-width: 989px) {
    .ai-multicolumn-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_tablet }}, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-multicolumn-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }

    .ai-multicolumn-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.85);
    }

    .ai-multicolumn-item-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.item_heading_size }}px * 0.9);
    }

    .ai-multicolumn-item-text-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.item_text_size }}px * 0.95);
    }
  }
{% endstyle %}

<multicolumn-block-{{ ai_gen_id }} class="ai-multicolumn-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-multicolumn-container-{{ ai_gen_id }}">
    <div class="ai-multicolumn-inner-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <div class="ai-multicolumn-heading-{{ ai_gen_id }}">
          <h2 class="ai-multicolumn-title-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        </div>
      {% endif %}

      <div class="ai-multicolumn-grid-{{ ai_gen_id }}">
        {% for i in (1..block.settings.columns_desktop) %}
          {% liquid
            assign image_key = 'column_' | append: i | append: '_image'
            assign video_key = 'column_' | append: i | append: '_video'
            assign title_key = 'column_' | append: i | append: '_title'
            assign text_key = 'column_' | append: i | append: '_text'

            assign column_image = block.settings[image_key]
            assign column_video = block.settings[video_key]
            assign column_title = block.settings[title_key]
            assign column_text = block.settings[text_key]
          %}

          <div class="ai-multicolumn-item-{{ ai_gen_id }}">
            <div class="ai-multicolumn-media-wrapper-{{ ai_gen_id }}">
              {% if column_video != blank %}
                {% liquid
                  assign video_ext = column_video.sources[1].url | split: '.' | last | downcase
                  if video_ext == 'gif'
                    assign is_gif = true
                  else
                    assign is_gif = false
                  endif
                %}
                
                {% if is_gif %}
                  <img
                    src="{{ column_video.sources[1].url }}"
                    alt="{{ column_video.alt | escape }}"
                    class="ai-multicolumn-media-{{ ai_gen_id }}"
                    loading="lazy"
                  >
                {% else %}
                  <video
                    class="ai-multicolumn-video-{{ ai_gen_id }}"
                    autoplay
                    loop
                    muted
                    playsinline
                  >
                    {% for source in column_video.sources %}
                      <source src="{{ source.url }}" type="{{ source.mime_type }}">
                    {% endfor %}
                  </video>
                {% endif %}
              {% elsif column_image != blank %}
                <img
                  src="{{ column_image | image_url: width: 800 }}"
                  alt="{{ column_image.alt | escape }}"
                  class="ai-multicolumn-media-{{ ai_gen_id }}"
                  loading="lazy"
                  width="{{ column_image.width }}"
                  height="{{ column_image.height }}"
                >
              {% else %}
                <div class="ai-multicolumn-placeholder-{{ ai_gen_id }}">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>

            {% if column_title != blank %}
              <h3 class="ai-multicolumn-item-title-{{ ai_gen_id }}">{{ column_title }}</h3>
            {% endif %}

            {% if column_text != blank %}
              <div class="ai-multicolumn-item-text-{{ ai_gen_id }}">{{ column_text }}</div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</multicolumn-block-{{ ai_gen_id }}>

<script>
  (function() {
    class MulticolumnBlock{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.videos = this.querySelectorAll('.ai-multicolumn-video-{{ ai_gen_id }}');
        this.setupVideoPlayback();
      }

      setupVideoPlayback() {
        this.videos.forEach((video) => {
          video.addEventListener('loadedmetadata', () => {
            video.play().catch(() => {});
          });
        });
      }
    }

    customElements.define('multicolumn-block-{{ ai_gen_id }}', MulticolumnBlock{{ ai_gen_id }});
  })();
</script>

