    "collapsible_content_xXMGyQ": {
      "type": "collapsible-content",
      "blocks": {
        "collapsible_row_aR3wnf": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Making Formula Changes",
            "icon": "washing",
            "row_content": "<p><strong>$2,000 +</strong></p><p>$2,000 minimum spend, + $400/ hour ( Non-inclusive of material costs )</p><p><em>Example: Jane's Soaps wants to use Rustic Strength Body Wash but add aloe and make it foamier</em></p>",
            "page": ""
          }
        },
        "collapsible_row_9JQNGD": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Manufacturing Your Formula",
            "icon": "washing",
            "row_content": "<p><strong>$2,000 + | Free Evaluation</strong></p><p>Send us your existing product formula. We will manufacture it on your behalf in our facility. </p><ul><li>Beginning production & any development work begins at: $2,000 minimum spend, + $400/ hour</li></ul>",
            "page": ""
          }
        },
        "collapsible_row_N7hkfm": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Custom Product Development",
            "icon": "washing",
            "row_content": "<p><strong>$50,000 +</strong></p><p>Develop a new product from scratch</p><ul><li>$50,000 minimum spend, + $400/ hour ( Non-inclusive of material/ sample/ shipping costs )</li></ul><p><em>Example: Jane's Soaps wants to make their own Body Wash, preferably using a mixture of ingredients X, Y & Z</em></p>",
            "page": ""
          }
        }
      },
