<button
  type="button"
  class="header__icon header__icon--search link focus-inset"
  aria-label="{{ 'general.search.search' | t }}"
  data-rebuy-disable="true"
  onclick="event.preventDefault(); event.stopPropagation(); if (event.stopImmediatePropagation) event.stopImmediatePropagation(); const drawer = document.querySelector('search-drawer'); if (drawer) drawer.open(this);"
>
  <span class="svg-wrapper">
    {{- 'icon-search.svg' | inline_asset_content -}}
  </span>
</button>
