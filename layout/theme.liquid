    {%- if template == 'page.b2b-application-form' -%}
      <script>
        document.addEventListener('DOMContentLoaded', function () {
          const targetTag = 'shopify-forms-embed';

          try {
            sessionStorage.removeItem('ws_flagged_spam');
          } catch (e) {}

          const getSafeSessionItem = (key) => {
            try {
              return sessionStorage.getItem(key) || '';
            } catch (e) {
              return '';
            }
          };

          const setSafeSessionItem = (key, val) => {
            try {
              sessionStorage.setItem(key, val);
            } catch (e) {}
          };

          const getSafeTrackingItem = (param) => {
            try {
              return (
                sessionStorage.getItem('ws_' + param) ||
                localStorage.getItem('ws_' + param) ||
                localStorage.getItem('ws_first_' + param) ||
                ''
              );
            } catch (e) {
              return '';
            }
          };

          const getSafeFirstTrackingItem = (param) => {
            try {
              return (
                localStorage.getItem('ws_first_' + param) ||
                sessionStorage.getItem('ws_' + param) ||
                localStorage.getItem('ws_' + param) ||
                ''
              );
            } catch (e) {
              return '';
            }
          };

          const getSafeCookieVal = (name) => {
            try {
              const value = `; ${document.cookie}`;
              const parts = value.split(`; ${name}=`);
              return parts.length === 2 ? parts.pop().split(';').shift() : '';
            } catch (e) {
              return '';
            }
          };

          function forceReactValueUpdate(element, newValue) {
            const prototype =
              element.tagName === 'TEXTAREA' ? HTMLTextAreaElement.prototype : HTMLInputElement.prototype;
            const descriptor = Object.getOwnPropertyDescriptor(prototype, 'value');
            if (descriptor && descriptor.set) {
              descriptor.set.call(element, newValue);
              element.dispatchEvent(new Event('input', { bubbles: true }));
              element.dispatchEvent(new Event('change', { bubbles: true }));
            }
          }

          function initiateHoneypotAndUtms(embedEl) {
            if (!embedEl || !embedEl.shadowRoot) {
              return false;
            }

            const appForm = embedEl.shadowRoot.querySelector('form[data-testid="form"]');

            if (!appForm) {
              return false;
            }

            const trackingAllowed = window.rsPrivacyConsent?.isMarketingAllowed() !== false;

            const trackingFields = [
              { id: 'attribution#utm_source', val: trackingAllowed ? getSafeTrackingItem('utm_source') : '' },
              { id: 'attribution#utm_medium', val: trackingAllowed ? getSafeTrackingItem('utm_medium') : '' },
              { id: 'attribution#utm_campaign', val: trackingAllowed ? getSafeTrackingItem('utm_campaign') : '' },
              { id: 'attribution#utm_content', val: trackingAllowed ? getSafeTrackingItem('utm_content') : '' },
              { id: 'attribution#utm_term', val: trackingAllowed ? getSafeTrackingItem('utm_term') : '' },
              { id: 'attribution#first_utm_source', val: trackingAllowed ? getSafeFirstTrackingItem('utm_source') : '' },
              { id: 'attribution#first_utm_medium', val: trackingAllowed ? getSafeFirstTrackingItem('utm_medium') : '' },
              {
                id: 'attribution#first_utm_campaign',
                val: trackingAllowed ? getSafeFirstTrackingItem('utm_campaign') : '',
              },
              {
                id: 'attribution#first_utm_content',
                val: trackingAllowed ? getSafeFirstTrackingItem('utm_content') : '',
              },
              { id: 'attribution#first_utm_term', val: trackingAllowed ? getSafeFirstTrackingItem('utm_term') : '' },
              {
                id: 'attribution#meta_tracking_data',
                val: trackingAllowed
                  ? `fbp:${getSafeCookieVal('_fbp')}||fbc:${getSafeCookieVal('_fbc')}||ua:${navigator.userAgent}`
                  : '',
              },
            ];

            const hideTrackingFields = () => {
              const formLabels = embedEl.shadowRoot.querySelectorAll('label, span');
              formLabels.forEach((label) => {
                const labelText = (label.textContent || '').toLowerCase();
                if (
                  labelText.includes('attribution utm') ||
                  labelText.includes('meta tracking data') ||
                  labelText.includes('attribution hashed email') ||
                  labelText.includes('first touch') ||
                  labelText.includes('attribution')
                ) {
                  const fieldRow =
                    label.closest('._formFieldContainer_1mxsl_5') ||
                    label.closest('[data-testid*="field"]') ||
                    label.parentElement;
                  if (fieldRow) {
                    fieldRow.style.setProperty('display', 'none', 'important');
                  }
                }
              });
            };

            const setupStaticFields = () => {
              trackingFields.forEach((field) => {
                const input = embedEl.shadowRoot.getElementById(field.id);
                if (input && field.val) {
                  if (!input.value || input.value !== field.val) {
                    forceReactValueUpdate(input, field.val);
                  }
                }
              });
            };

            hideTrackingFields();
            setupStaticFields();

            if (embedEl.shadowRoot.getElementById('ws_honeypot_wrapper')) {
              return true;
            }

            const honeypotWrapper = document.createElement('div');
            honeypotWrapper.id = 'ws_honeypot_wrapper';
            honeypotWrapper.setAttribute('aria-hidden', 'true');
            honeypotWrapper.style.cssText =
              'position: absolute !important; left: -9999px !important; top: -9999px !important; opacity: 0 !important; pointer-events: none !important; z-index: -1 !important; height: 0 !important; width: 0 !important; overflow: hidden !important;';

            honeypotWrapper.innerHTML = `
              <label for="form_ws_alt_routing_num">System Route ID (Leave Blank)</label>
              <input id="form_ws_alt_routing_num" type="text" name="ws_alt_routing_num" autocomplete="off" data-lpignore="true" data-1p-ignore="true" tabindex="-1">
            `;
            appForm.prepend(honeypotWrapper);

            async function computeEmailHash(emailStr) {
              const msgBuffer = new TextEncoder().encode(emailStr.toLowerCase().trim());
              const hashBuffer = await crypto.subtle.digest('SHA-256', msgBuffer);
              const hashArray = Array.from(new Uint8Array(hashBuffer));
              return hashArray.map((b) => b.toString(16).padStart(2, '0')).join('');
            }

            const emailInput = embedEl.shadowRoot.getElementById('email');
            if (emailInput) {
              emailInput.addEventListener('input', async function () {
                const currentEmail = emailInput.value.trim();
                if (currentEmail) {
                  const generatedHash = await computeEmailHash(currentEmail);
                  const hashedInput = embedEl.shadowRoot.getElementById('attribution#hashed_email');
                  if (hashedInput && hashedInput.value !== generatedHash) {
                    forceReactValueUpdate(hashedInput, generatedHash);
                  }
                }
              });
            }

            function evaluateHoneypotSpam() {
              const honeypotInput = embedEl.shadowRoot.getElementById('form_ws_alt_routing_num');
              if (honeypotInput && honeypotInput.value.trim() !== '') {
                setSafeSessionItem('ws_flagged_spam', 'true');

                const metaTrackingField = embedEl.shadowRoot.getElementById('attribution#meta_tracking_data');
                if (metaTrackingField && !metaTrackingField.value.includes('spam:true')) {
                  const updatedMetaValue = metaTrackingField.value + '||spam:true';
                  forceReactValueUpdate(metaTrackingField, updatedMetaValue);
                }
              }
            }

            const honeypotInput = embedEl.shadowRoot.getElementById('form_ws_alt_routing_num');
            if (honeypotInput) {
              honeypotInput.addEventListener('input', evaluateHoneypotSpam);
              honeypotInput.addEventListener('change', evaluateHoneypotSpam);
              honeypotInput.addEventListener('blur', evaluateHoneypotSpam);
            }

            const submitButton =
              appForm.querySelector('[data-testid="btn-form-submit"]') ||
              appForm.querySelector('button[type="submit"]');
            if (submitButton) {
              submitButton.addEventListener('pointerdown', evaluateHoneypotSpam);
              submitButton.addEventListener('click', evaluateHoneypotSpam);
            }

            appForm.addEventListener('submit', function (e) {
              evaluateHoneypotSpam();

              const honeypotInput = embedEl.shadowRoot.getElementById('form_ws_alt_routing_num');
              if (honeypotInput && honeypotInput.value.trim() !== '') {
                return;
              }

              if (appForm.dataset.tracked === 'true') {
                return;
              }
              appForm.dataset.tracked = 'true';
              setTimeout(() => {
                appForm.dataset.tracked = 'false';
              }, 3000);

              const emailValue = emailInput ? emailInput.value.trim() : '';

              if (emailValue && window.rsPrivacyConsent?.isMarketingAllowed() !== false) {
                const klaviyo = window.klaviyo || window._learnq || [];
                const trackingParams = [
                  'utm_source',
                  'utm_medium',
                  'utm_campaign',
                  'utm_content',
                  'utm_term',
                  'gclid',
                  'fbclid',
                ];
                const utmData = {};

                trackingParams.forEach((param) => {
                  utmData[param] = getSafeTrackingItem(param);
                  utmData['first_' + param] = getSafeFirstTrackingItem(param);
                });

                utmData['landing_page'] = getSafeTrackingItem('landing_page') || window.location.href;
                utmData['first_landing_page'] = getSafeFirstTrackingItem('landing_page') || window.location.href;
                utmData['referrer'] = getSafeTrackingItem('referrer');
                utmData['first_referrer'] = getSafeFirstTrackingItem('referrer');

                const profileProperties = { $email: emailValue };
                Object.keys(utmData).forEach((param) => {
                  if (utmData[param] !== '') {
                    profileProperties[param] = utmData[param];
                  }
                });

                if (typeof klaviyo.push === 'function') {
                  klaviyo.push(['identify', profileProperties]);
                  klaviyo.push(['track', 'Wholesale Application Submitted', utmData]);
                }
              }
            });

            return true;
          }

          const embedEl = document.getElementById('app-embed') || document.querySelector(targetTag);

          if (embedEl && initiateHoneypotAndUtms(embedEl)) {
            return;
          }

          const observer = new MutationObserver((mutations, obs) => {
            const currentEmbed = document.getElementById('app-embed') || document.querySelector(targetTag);

            if (currentEmbed && currentEmbed.shadowRoot) {
              const success = initiateHoneypotAndUtms(currentEmbed);

              if (success) {
                obs.disconnect();
              }
            }
          });

          observer.observe(document.body, {
            childList: true,
            subtree: true,
          });
        });
      </script>
    {%- endif -%}
    <script>
      window.addEventListener(
        'submit',
        function (e) {
          const form = e.target;

          if (
            form &&
            form.action &&
            form.action.includes('/cart/add') &&
            !form.closest('.quick-order-list') &&
            !form.closest('[data-quick-order]')
          ) {
            e.preventDefault();
            e.stopPropagation();

            const submitButton = form.querySelector('[type="submit"], .product-form__submit');
            const originalText = submitButton ? submitButton.innerText : 'Add to Cart';

            if (submitButton) {
              submitButton.disabled = true;
              submitButton.innerText = 'Adding...';
            }

            fetch(window.Shopify.routes.root + 'cart/add.js', {
              method: 'POST',
              body: new FormData(form),
            })
              .then((response) => response.json())
              .then((data) => {
                if (submitButton) {
                  submitButton.innerText = '✓ Added!';

                  setTimeout(function () {
                    submitButton.disabled = false;
                    submitButton.innerText = originalText;
                  }, 2000);
                }

                if (window.Rebuy && window.Rebuy.Cart) {
                  window.Rebuy.Cart.getCart();
                }
              })
              .catch((error) => {
                console.error('Silent add failed:', error);
                if (submitButton) {
                  submitButton.disabled = false;
                  submitButton.innerText = originalText;
                }
              });
          }
        },
        true
      );

      document.addEventListener('DOMContentLoaded', function () {
        document.addEventListener('rebuy:smartcart.ready', function (event) {
          if (window.Rebuy && window.Rebuy.SmartCart && !window.Rebuy.SmartCart.isOverridden) {
            const originalShow = window.Rebuy.SmartCart.show;

            window.Rebuy.SmartCart.show = function (force) {
              if (force === true) {
                originalShow.call(window.Rebuy.SmartCart);
              } else {
                console.log('Automated Rebuy open hook silenced.');
              }
            };

            window.Rebuy.SmartCart.isOverridden = true;
          }
        });

        document
          .querySelectorAll('a[href="/cart"], .header__cart-icon, [data-cart-trigger], .cart-link')
          .forEach(function (cartIcon) {
            cartIcon.addEventListener('click', function (e) {
              if (window.Rebuy && window.Rebuy.SmartCart) {
                e.preventDefault();
                e.stopPropagation();
                window.Rebuy.SmartCart.show(true);
              }
            });
          });
      });
    </script>
  </body>
</html>
