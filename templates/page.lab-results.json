      "name": "Lab results growth intake",
      "settings": {
        "info_heading": "This program is growing",
        "info_body": "<p>We test as fast as we responsibly can. Independent lab testing is expensive and takes time, so we roll it out in waves, starting with the products you use most and the contaminants that matter most. We would rather test fewer things properly than put a badge on everything. We add results here as they come back, and every report names the lab that ran it.</p>",
        "suggest_heading": "Tell us what to test next",
        "suggest_description": "Is there an ingredient or a product you want screened? Tell us. The most-requested tests move up the list.",
        "input_what_label": "An ingredient or a product, like 1,4-dioxane or dish soap",
        "input_email_label": "Email (optional, so we can tell you when we test it)",
        "submit_label": "Submit a test request",
        "success_message": "Thanks. We read every request, and the ones we hear most move up the list.",
        "success_email_message": "We will let you know when this one is tested.",
        "color_scheme": "scheme-2",
        "card_background_color": "",
        "input_background_color": "",
        "section_show_on_desktop": true,
        "section_show_on_mobile": true,
        "section_padding_top_on_desktop": 60,
        "section_padding_bottom_on_desktop": 20,
        "section_padding_top_on_mobile": 40,
        "section_padding_bottom_on_mobile": 40,
        "section_make_rounded": true
      }
    },
