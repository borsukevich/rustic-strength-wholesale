{% doc %}
  @prompt
    Create a Counter Highlights section. Each column should have a rich text option, a number counter that counts up to the designated number when the page is viewed. It should include a Rich text Heading & subheading above the columns. Each column should have the option to add an image on the left or right of the counter. The colors should have the same scheme options as the theme. All fonts will be attributed from the theme., allow exact numbers, The images say "left" or "right" but are above or below the counter, I want them to be to the Left or Right of the counter in each column. Allow the images to be bigger than currently available.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-counter-highlights-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 40px 20px;
  }

  .ai-counter-highlights__inner-{{ ai_gen_id }} {
    max-width: {{ settings.page_width }}px;
    margin: 0 auto;
    width: {{ block.settings.desktop_width_percent }}%;
  }

  .ai-counter-highlights__header-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
    margin-bottom: 40px;
  }

  .ai-counter-highlights__heading-{{ ai_gen_id }} {
    margin: 0 0 16px;
    font-family: {{ settings.type_header_font.family }}, {{ settings.type_header_font.fallback_families }};
    font-weight: {{ settings.type_header_font.weight }};
    font-style: {{ settings.type_header_font.style }};
  }

  .ai-counter-highlights__subheading-{{ ai_gen_id }} {
    margin: 0;
    font-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
    font-weight: {{ settings.type_body_font.weight }};
    font-style: {{ settings.type_body_font.style }};
  }

  .ai-counter-highlights__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.column_gap }}px;
  }

  .ai-counter-highlights__column-{{ ai_gen_id }} {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 20px;
    padding: 30px;
    background-color: rgb(var(--color-background));
    border-radius: {{ settings.text_boxes_radius }}px;
    {% if settings.text_boxes_border_thickness > 0 %}
      border: {{ settings.text_boxes_border_thickness }}px solid rgba(var(--color-foreground), {{ settings.text_boxes_border_opacity | divided_by: 100.0 }});
    {% endif %}
    {% if settings.text_boxes_shadow_opacity > 0 %}
      box-shadow: {{ settings.text_boxes_shadow_horizontal_offset }}px {{ settings.text_boxes_shadow_vertical_offset }}px {{ settings.text_boxes_shadow_blur }}px rgba(var(--color-shadow), {{ settings.text_boxes_shadow_opacity | divided_by: 100.0 }});
    {% endif %}
  }

  .ai-counter-highlights__column--reverse-{{ ai_gen_id }} {
    flex-direction: row-reverse;
  }

  .ai-counter-highlights__image-wrapper-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.image_size }}px;
    height: {{ block.settings.image_size }}px;
  }

  .ai-counter-highlights__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: {{ settings.media_radius }}px;
  }

  .ai-counter-highlights__content-{{ ai_gen_id }} {
    flex: 1;
    text-align: {{ block.settings.column_text_alignment }};
  }

  .ai-counter-highlights__counter-{{ ai_gen_id }} {
    font-size: {{ block.settings.counter_size }}px;
    font-weight: 700;
    margin: 0 0 8px;
    font-family: {{ settings.type_header_font.family }}, {{ settings.type_header_font.fallback_families }};
    color: rgb(var(--color-foreground));
  }

  .ai-counter-highlights__label-{{ ai_gen_id }} {
    margin: 0;
    font-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
    font-weight: {{ settings.type_body_font.weight }};
    font-style: {{ settings.type_body_font.style }};
    color: rgb(var(--color-foreground));
  }

  @media screen and (max-width: 749px) {
    .ai-counter-highlights__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }

    .ai-counter-highlights__column-{{ ai_gen_id }} {
      padding: 20px;
      flex-direction: column;
    }

    .ai-counter-highlights__column--reverse-{{ ai_gen_id }} {
      flex-direction: column;
    }

    .ai-counter-highlights__counter-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.counter_size }}px * 0.8);
    }

    .ai-counter-highlights__image-wrapper-{{ ai_gen_id }} {
      width: calc({{ block.settings.image_size }}px * 0.8);
      height: calc({{ block.settings.image_size }}px * 0.8);
    }
  }
{% endstyle %}

<counter-highlights-{{ ai_gen_id }}
  class="ai-counter-highlights-{{ ai_gen_id }} color-{{ block.settings.color_scheme }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-counter-highlights__inner-{{ ai_gen_id }}">
    {% if block.settings.heading != blank or block.settings.subheading != blank %}
      <div class="ai-counter-highlights__header-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <div class="ai-counter-highlights__heading-{{ ai_gen_id }}">
            {{ block.settings.heading }}
          </div>
        {% endif %}
        {% if block.settings.subheading != blank %}
          <div class="ai-counter-highlights__subheading-{{ ai_gen_id }}">
            {{ block.settings.subheading }}
          </div>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-counter-highlights__grid-{{ ai_gen_id }}">
      {% for i in (1..4) %}
        {% liquid
          assign counter_enabled_key = 'counter_' | append: i | append: '_enabled'
          assign counter_number_key = 'counter_' | append: i | append: '_number'
          assign counter_suffix_key = 'counter_' | append: i | append: '_suffix'
          assign counter_label_key = 'counter_' | append: i | append: '_label'
          assign counter_image_key = 'counter_' | append: i | append: '_image'

          assign counter_enabled = block.settings[counter_enabled_key]
          assign counter_number = block.settings[counter_number_key]
          assign counter_suffix = block.settings[counter_suffix_key]
          assign counter_label = block.settings[counter_label_key]
          assign counter_image = block.settings[counter_image_key]
        %}

        {% if counter_enabled %}
          <div class="ai-counter-highlights__column-{{ ai_gen_id }} {% if block.settings.image_position == 'right' %}ai-counter-highlights__column--reverse-{{ ai_gen_id }}{% endif %}">
            {% if counter_image != blank %}
              <div class="ai-counter-highlights__image-wrapper-{{ ai_gen_id }}">
                <img
                  src="{{ counter_image | image_url: width: 400 }}"
                  alt="{{ counter_image.alt | escape }}"
                  class="ai-counter-highlights__image-{{ ai_gen_id }}"
                  loading="lazy"
                  width="400"
                  height="400"
                >
              </div>
            {% endif %}

            <div class="ai-counter-highlights__content-{{ ai_gen_id }}">
              <div
                class="ai-counter-highlights__counter-{{ ai_gen_id }}"
                data-target="{{ counter_number }}"
                data-suffix="{{ counter_suffix }}"
              >
                0{{ counter_suffix }}
              </div>
              {% if counter_label != blank %}
                <div class="ai-counter-highlights__label-{{ ai_gen_id }}">
                  {{ counter_label }}
                </div>
              {% endif %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</counter-highlights-{{ ai_gen_id }}>

<script>
  (function() {
    class CounterHighlights{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.counters = this.querySelectorAll('.ai-counter-highlights__counter-{{ ai_gen_id }}');
        this.hasAnimated = false;
      }

      connectedCallback() {
        this.setupIntersectionObserver();
      }

      setupIntersectionObserver() {
        const options = {
          root: null,
          rootMargin: '0px',
          threshold: 0.3
        };

        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting && !this.hasAnimated) {
              this.hasAnimated = true;
              this.animateCounters();
            }
          });
        }, options);

        observer.observe(this);
      }

      animateCounters() {
        this.counters.forEach((counter) => {
          const target = parseInt(counter.getAttribute('data-target'));
          const suffix = counter.getAttribute('data-suffix') || '';
          const duration = 2000;
          const increment = target / (duration / 16);
          let current = 0;

          const updateCounter = () => {
            current += increment;
            if (current < target) {
              counter.textContent = Math.floor(current) + suffix;
              requestAnimationFrame(updateCounter);
            } else {
              counter.textContent = target + suffix;
            }
          };

          updateCounter();
        });
      }
    }

    customElements.define('counter-highlights-{{ ai_gen_id }}', CounterHighlights{{ ai_gen_id }});
  })();
</script>

